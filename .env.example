# Copy to .env and fill in your own values

# Email for polite Unpaywall / NCBI requests (use your own email)
# (the pre-rename PAPER_EXTRACT_EMAIL is still honoured)
PAPER_DOWNLOAD_EMAIL=

# NCBI PubMed API key (raises E-utilities rate limit 3 -> 10 req/s): https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Publisher fulltext APIs (optional, for OA fulltext fetching)
SPRINGER_OA_API_KEY=
ELSEVIER_API_KEY=
WILEY_TDM_TOKEN=
CORE_API_KEY=

# LLM (for search-plan --prompt / alias expansion; set one or more, served by the standalone llmclient package)
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
